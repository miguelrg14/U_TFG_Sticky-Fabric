/Sticky-Fabric/[Ll]ibrary/
/Sticky-Fabric/[Tt]emp/
/Sticky-Fabric/[Oo]bj/
/Sticky-Fabric/[Bb]uild/
/Sticky-Fabric/[Bb]uilds/
/Sticky-Fabric/[Ll]ogs/
/Sticky-Fabric/[Uu]ser[Ss]ettings/
/Sticky-Fabric/[Mm]emoryCaptures/
/Sticky-Fabric/[Rr]ecordings/
/Sticky-Fabric/ExportedObj/
/Sticky-Fabric/.consulo/
/Sticky-Fabric/.utmp/

# Files Unity and the IDEs regenerate inside the Unity project
/Sticky-Fabric/*.csproj
/Sticky-Fabric/*.sln
/Sticky-Fabric/*.slnx
/Sticky-Fabric/*.unityproj
/Sticky-Fabric/Assets/Plugins/Editor/JetBrains*

# Play mode test runner scenes
InitTestScene*.unity*

# Crash reports and build outputs
sysinfo.txt
mono_crash.*
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta

# Blender backups
*.blend1
*.blend1.meta

# ---------------------------------------------------------------------------
# .NET tooling (tests/, tools/)
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
TestResults/
/build/

# ---------------------------------------------------------------------------
# IDEs and OS
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
