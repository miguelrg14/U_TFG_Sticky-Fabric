<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the engine-independent solver tests outside Unity.
    The sources are the same files Unity compiles: the core lives in the Unity project
    and the NUnit tests are shared with the Unity EditMode test assembly.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Unity 6 compiles C# 9; keep the shared code within that language version. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Sticky-Fabric/Assets/StickyFabric/Runtime/Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Sticky-Fabric/Assets/StickyFabric/Tests/EditMode/Core/**/*.cs" Link="Tests/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
